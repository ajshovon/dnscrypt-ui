<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DNSCrypt UI</vendor>
  <action id="io.github.shovon.DNSCryptUI.helper">
    <description>Change encrypted DNS settings</description>
    <message>Authentication is required to change dnscrypt-proxy and system DNS settings</message>
    <icon_name>io.github.shovon.DNSCryptUI</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/dnscrypt-ui-helper</annotate>
  </action>
</policyconfig>

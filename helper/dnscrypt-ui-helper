#!/usr/bin/python3 -I
"""
Privileged helper for DNSCrypt UI. Runs as root through pkexec.

Commands:
  apply            Read {"toml", "rules", "base": {"toml", "rules"}} JSON from
                   stdin. Refuses if the files changed since the app loaded them
                   (base = SHA-256 of the files it loaded) or if the new config
                   changes anything the app does not manage. Then backs up,
                   writes, checks with dnscrypt-proxy, restarts, and rolls back
                   when the service does not come up.
  setup-dns ADDR   Route all system DNS through dnscrypt-proxy at ADDR
                   (loopback ip:port) via systemd-resolved, without leaks.
  undo-dns         Remove the DNS routing set up by setup-dns.
  disable          Turn encrypted DNS off: give system DNS back to the network
                   (routing is parked, not deleted), then stop dnscrypt-proxy.
  enable           Turn encrypted DNS on: start dnscrypt-proxy and, once it
                   answers, restore routing parked by `disable`.

Writes a single JSON object to stdout: {"ok": bool, "message": str, ...}.
This file is standalone (no imports from the app) so it can be installed
root-owned outside the user's reach.
"""

import hashlib
import ipaddress
import json
import os
import pwd
import random
import re
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import time
import tomllib
from pathlib import Path

CONFIG_DIR = Path("/etc/dnscrypt-proxy")
TOML_NAME = "dnscrypt-proxy.toml"
BACKUP_ROOT = CONFIG_DIR / ".dnscrypt-ui-backup"
CONFIG_BACKUPS = BACKUP_ROOT / "config"
NETWORK_BACKUPS = BACKUP_ROOT / "network"
PARK_DIR = CONFIG_DIR / ".dnscrypt-ui-parked"
LOG_DIR = Path("/var/log/dnscrypt-proxy")
CACHE_DIR = Path("/var/cache/dnscrypt-proxy")
SERVICE = "dnscrypt-proxy.service"
BINARY = "/usr/bin/dnscrypt-proxy"

RESOLVED_DROPIN = Path("/etc/systemd/resolved.conf.d/zz-dnscrypt-ui.conf")
LEGACY_RESOLVED_DROPIN = Path("/etc/systemd/resolved.conf.d/dnscrypt.conf")
NM_DROPIN = Path("/etc/NetworkManager/conf.d/90-dnscrypt-ui.conf")
SERVICE_DROPIN = Path("/etc/systemd/system/dnscrypt-proxy.service.d/50-dnscrypt-ui.conf")
RESOLV_CONF = Path("/etc/resolv.conf")
STUB_RESOLV = "../run/systemd/resolve/stub-resolv.conf"

# Files that make up "system DNS goes through dnscrypt-proxy", by park/backup label
ROUTING_FILES = {
    "resolved.conf": RESOLVED_DROPIN,
    "networkmanager.conf": NM_DROPIN,
    "service.conf": SERVICE_DROPIN,
}

MAX_INPUT = 4 * 1024 * 1024
KEEP_BACKUPS = 10
MISSING = object()
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._\-]{0,99}$")
STAMP_RE = re.compile(r"^sdns://[A-Za-z0-9_\-]+=*$")
BOOL_KEYS = {"doh_servers", "dnscrypt_servers", "require_dnssec", "require_nolog", "require_nofilter"}


class HelperError(Exception):
    def __init__(self, message, **extra):
        super().__init__(message)
        self.extra = extra


def run(argv, timeout=60, check=False):
    res = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    if check and res.returncode != 0:
        raise HelperError(f"{' '.join(argv)} failed: {(res.stderr or res.stdout).strip()[-400:]}")
    return res


def restorecon(*paths):
    if shutil.which("restorecon"):
        run(["restorecon", "-R", *[str(p) for p in paths]])


def atomic_write(path: Path, content: str, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    restorecon(path)


def inside(path: Path, directory: Path) -> bool:
    try:
        path.resolve().relative_to(directory.resolve())
        return True
    except ValueError:
        return False


def sha256_of(path: Path) -> str:
    try:
        data = path.read_bytes()
    except FileNotFoundError:
        data = b""
    return hashlib.sha256(data).hexdigest()


def journal_tail() -> str:
    return run(["journalctl", "-u", SERVICE, "-n", "15", "--no-pager", "-o", "cat"], timeout=10).stdout.strip()[-1500:]


# Backups

def backup(files: dict, root: Path) -> Path:
    """Copies {label: path} into a new timestamped directory under root."""
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = root / stamp
    n = 1
    while dest.exists():
        dest = root / f"{stamp}-{n}"
        n += 1
    dest.mkdir(parents=True, mode=0o700)
    for label, p in files.items():
        if p.exists() and not p.is_symlink():
            shutil.copy2(p, dest / label)
    old = sorted(d for d in root.iterdir() if d.is_dir())
    for d in old[:-KEEP_BACKUPS]:
        shutil.rmtree(d, ignore_errors=True)
    return dest


def restore(backup_dir: Path, files: dict):
    for label, p in files.items():
        saved = backup_dir / label
        if saved.exists():
            atomic_write(p, saved.read_text(encoding="utf-8"))
        elif p.exists():
            p.unlink()


# Addresses

def parse_addr(addr: str):
    addr = addr.strip()
    if addr.startswith("["):
        host, _, port = addr[1:].partition("]:")
    elif addr.count(":") == 1:
        host, port = addr.split(":")
    else:
        host, port = addr, "53"
    try:
        port = int(port or 53)
        if not 0 < port < 65536:
            raise ValueError
        return ipaddress.ip_address(host), port
    except ValueError:
        raise HelperError(f"Invalid address: {addr}")


def loopback_addr(addr) -> tuple:
    if not isinstance(addr, str):
        raise HelperError("Addresses must be strings")
    host, port = parse_addr(addr)
    if not host.is_loopback:
        raise HelperError(f"dnscrypt-proxy may only listen on loopback addresses, not {addr}")
    return host, port


def resolved_dns_value(addr: str) -> str:
    host, port = loopback_addr(addr)
    if port == 53:
        return str(host)
    return f"[{host}]:{port}" if host.version == 6 else f"{host}:{port}"


# apply: what the app may change

def rules_path_for(parsed: dict) -> Path:
    raw = str(parsed.get("forwarding_rules", "forwarding-rules.txt"))
    p = Path(raw)
    p = p if p.is_absolute() else CONFIG_DIR / p
    if p.is_symlink() or not inside(p, CONFIG_DIR) or p.parent.resolve() != CONFIG_DIR.resolve():
        raise HelperError(f"forwarding_rules must name a file directly inside {CONFIG_DIR}")
    return p


def flatten(table: dict, prefix=()) -> dict:
    """{('a', 'b'): value} for every non-table value; tables are recursed into."""
    out = {}
    for key, value in table.items():
        path = prefix + (key,)
        if isinstance(value, dict):
            out.update(flatten(value, path))
        else:
            out[path] = value
    return out


def check_change(path: tuple, value):
    """Raises unless DNSCrypt UI is allowed to set `path` to `value` (MISSING = removed)."""
    name = ".".join(path)

    def str_list(v):
        return isinstance(v, list) and all(isinstance(x, str) for x in v)

    if len(path) == 1:
        key = path[0]
        if key == "listen_addresses":
            if not str_list(value) or not value:
                raise HelperError("listen_addresses must be a non-empty list")
            for addr in value:
                loopback_addr(addr)
            return
        if key == "server_names":
            if not str_list(value) or not all(NAME_RE.match(x) for x in value):
                raise HelperError("server_names must be a list of resolver names")
            return
        if key == "bootstrap_resolvers":
            if not str_list(value) or not value:
                raise HelperError("bootstrap_resolvers must be a non-empty list")
            for addr in value:
                parse_addr(addr)
            return
        if key == "fallback_resolvers" and value is MISSING:
            return  # migrated to bootstrap_resolvers
        if key in BOOL_KEYS:
            if not isinstance(value, bool):
                raise HelperError(f"{key} must be true or false")
            return
    elif path == ("query_log", "file"):
        if value is MISSING:
            return
        if not isinstance(value, str) or not value.startswith("/"):
            raise HelperError("query_log.file must be an absolute path")
        p = Path(os.path.normpath(value))
        if p == LOG_DIR or not inside(p, LOG_DIR):
            raise HelperError(f"The query log must be a file inside {LOG_DIR}")
        if p.is_symlink():
            raise HelperError("The query log must not be a symlink")
        return
    elif path == ("query_log", "format"):
        if value in ("tsv", "ltsv", MISSING):
            return
        raise HelperError("query_log.format must be tsv or ltsv")
    elif len(path) == 3 and path[0] == "static" and path[2] == "stamp":
        if not NAME_RE.match(path[1]):
            raise HelperError(f"Invalid static server name: {path[1]}")
        if value is MISSING or (isinstance(value, str) and STAMP_RE.match(value)):
            return
        raise HelperError(f"Invalid stamp for static server {path[1]}")

    raise HelperError(f"Refusing to change '{name}': DNSCrypt UI does not manage this setting")


def check_allowed_changes(old: dict, new: dict):
    fo, fn = flatten(old), flatten(new)
    for path in sorted(set(fo) | set(fn), key=repr):
        before, after = fo.get(path, MISSING), fn.get(path, MISSING)
        if before is not MISSING and after is not MISSING and before == after:
            continue
        check_change(path, after)


def validate_input(data) -> tuple:
    if (
        not isinstance(data, dict)
        or not isinstance(data.get("toml"), str)
        or not isinstance(data.get("rules"), str)
        or not isinstance(data.get("base"), dict)
    ):
        raise HelperError("Expected JSON with string fields 'toml' and 'rules' and object 'base'")
    try:
        parsed = tomllib.loads(data["toml"])
    except tomllib.TOMLDecodeError as e:
        raise HelperError(f"New configuration is not valid TOML: {e}")
    return parsed, rules_path_for(parsed)


def secure_query_log(parsed: dict):
    """The query log lists every domain looked up: root:<caller's group> 0640."""
    qfile = (parsed.get("query_log") or {}).get("file")
    if not qfile:
        return
    p = Path(os.path.normpath(qfile))
    p.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    if not p.exists():
        fd = os.open(p, os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o640)
        os.close(fd)
    if p.is_symlink():
        raise HelperError("The query log must not be a symlink")
    uid = os.environ.get("PKEXEC_UID", "")
    gid = 0
    if uid.isdigit():
        try:
            gid = pwd.getpwuid(int(uid)).pw_gid
        except KeyError:
            pass
    os.chown(p, 0, gid)
    os.chmod(p, 0o640)
    restorecon(p.parent)


def ensure_cache_dir():
    if not CACHE_DIR.exists():
        CACHE_DIR.mkdir(parents=True, mode=0o755)
        restorecon(CACHE_DIR)


def service_state():
    res = run(["systemctl", "show", SERVICE, "--property=ActiveState,SubState"], timeout=10)
    props = dict(l.split("=", 1) for l in res.stdout.splitlines() if "=" in l)
    return props.get("ActiveState", ""), props.get("SubState", "")


def wait_stable(timeout=20, hold=3) -> bool:
    """Type=simple units report "active" right after fork, so require the
    process to stay up for a few seconds before trusting it."""
    deadline = time.monotonic() + timeout
    active_since = None
    while time.monotonic() < deadline:
        if service_state()[0] == "active":
            active_since = active_since or time.monotonic()
            if time.monotonic() - active_since >= hold:
                return True
        else:
            active_since = None
        time.sleep(0.5)
    return False


def dns_probe(addr: str, timeout: float) -> bool:
    host, port = parse_addr(addr)
    if host.is_unspecified:
        host = ipaddress.ip_address("::1" if host.version == 6 else "127.0.0.1")
    family = socket.AF_INET6 if host.version == 6 else socket.AF_INET
    tid = random.randint(0, 0xFFFF)
    packet = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0) + b"\x00\x00\x02\x00\x01"  # . NS
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        with socket.socket(family, socket.SOCK_DGRAM) as s:
            s.settimeout(1.0)
            try:
                s.sendto(packet, (str(host), port))
                resp, _ = s.recvfrom(512)
                if len(resp) >= 2 and struct.unpack(">H", resp[:2])[0] == tid:
                    return True
            except OSError:
                pass
        time.sleep(0.5)
    return False


def current_listen() -> list:
    try:
        parsed = tomllib.loads((CONFIG_DIR / TOML_NAME).read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError):
        parsed = {}
    return parsed.get("listen_addresses") or ["127.0.0.1:53"]


def cmd_apply():
    raw = sys.stdin.read(MAX_INPUT + 1)
    if len(raw) > MAX_INPUT:
        raise HelperError("Input too large")
    try:
        data = json.loads(raw)
    except ValueError:
        raise HelperError("Input is not JSON")
    parsed, rules_path = validate_input(data)
    toml_path = CONFIG_DIR / TOML_NAME

    if (
        data["base"].get("toml") != sha256_of(toml_path)
        or data["base"].get("rules") != sha256_of(rules_path)
    ):
        raise HelperError(
            "The configuration was changed outside DNSCrypt UI after it was loaded. "
            "Reload it, then make your changes again.",
            stage="conflict",
        )
    try:
        current = tomllib.loads(toml_path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise HelperError(f"{toml_path} does not exist")
    except tomllib.TOMLDecodeError as e:
        raise HelperError(f"The current {toml_path} is not valid TOML ({e}); fix it by hand first")
    check_allowed_changes(current, parsed)

    targets = {TOML_NAME: toml_path, rules_path.name: rules_path}
    saved = backup(targets, CONFIG_BACKUPS)
    ensure_cache_dir()
    secure_query_log(parsed)
    atomic_write(rules_path, data["rules"])
    atomic_write(toml_path, data["toml"])

    check = run([BINARY, "-config", str(toml_path), "-check"], timeout=90)
    if check.returncode != 0:
        restore(saved, targets)
        raise HelperError(
            "dnscrypt-proxy rejected the new configuration. Nothing was changed.",
            stage="check",
            output=(check.stderr or check.stdout).strip()[-1500:],
        )

    was_active = service_state()[0] == "active"
    if was_active:
        run(["systemctl", "restart", SERVICE], timeout=60)
        if not wait_stable():
            journal = journal_tail()
            restore(saved, targets)
            run(["systemctl", "restart", SERVICE], timeout=60)
            raise HelperError(
                "dnscrypt-proxy did not start with the new configuration. The previous configuration was restored.",
                stage="restart",
                output=journal,
            )

    listen = parsed.get("listen_addresses") or ["127.0.0.1:53"]
    sync_resolved(listen[0])
    answering = dns_probe(listen[0], timeout=15) if was_active else None
    return {
        "ok": True,
        "message": "Configuration applied" + (" and dnscrypt-proxy restarted" if was_active else ""),
        "answering": answering,
        "backup": str(saved),
    }


# DNS routing

RESOLVED_TEMPLATE = (
    "# Managed by DNSCrypt UI: send every query to dnscrypt-proxy.\n"
    "[Resolve]\n"
    "DNS={dns}\n"
    "Domains=~.\n"
    "FallbackDNS=\n"
    "DNSOverTLS=no\n"
    "DNSStubListener=yes\n"
)
# Keep per-network DNS servers (DHCP) out of systemd-resolved, otherwise it
# sends queries to them in parallel and they leak unencrypted. dns=none alone
# is not enough: systemd-resolved=true (the default) makes NetworkManager push
# connection DNS to resolved regardless of dns=.
NM_TEXT = (
    "# Managed by DNSCrypt UI: do not push DHCP DNS servers to systemd-resolved.\n"
    "[main]\n"
    "dns=none\n"
    "systemd-resolved=false\n"
)
# The packaged unit waits 2 minutes before restarting a crashed proxy; with
# all system DNS going through it, that is 2 minutes without DNS.
SERVICE_TEXT = (
    "# Managed by DNSCrypt UI: system DNS depends on dnscrypt-proxy, restart it quickly.\n"
    "[Service]\n"
    "RestartSec=2s\n"
)


def sync_resolved(listen_addr: str):
    """Keep the resolved drop-in (active or parked) pointing at the listen address."""
    text = RESOLVED_TEMPLATE.format(dns=resolved_dns_value(listen_addr))
    parked = PARK_DIR / "resolved.conf"
    if parked.exists() and parked.read_text(encoding="utf-8") != text:
        atomic_write(parked, text)
    if RESOLVED_DROPIN.exists() and RESOLVED_DROPIN.read_text(encoding="utf-8") != text:
        atomic_write(RESOLVED_DROPIN, text)
        run(["systemctl", "restart", "systemd-resolved"], timeout=30, check=True)
        run(["resolvectl", "flush-caches"], timeout=10)


def clear_parked():
    if PARK_DIR.exists():
        shutil.rmtree(PARK_DIR, ignore_errors=True)


def ensure_serving(addr: str):
    """dnscrypt-proxy must be running and answering before system DNS points at it."""
    if service_state()[0] != "active":
        run(["systemctl", "start", SERVICE], timeout=60)
    if not wait_stable():
        raise HelperError(
            "dnscrypt-proxy is not running, so system DNS was left unchanged.",
            output=journal_tail(),
        )
    if not dns_probe(addr, timeout=20):
        raise HelperError(
            f"dnscrypt-proxy is running but not answering on {addr} yet, so system DNS was left "
            "unchanged. It may still be downloading its resolver list; try again in a minute."
        )


def cmd_setup_dns(addr: str):
    dns = resolved_dns_value(addr)
    ensure_serving(addr)

    backup_dir = backup({**ROUTING_FILES, "legacy-resolved.conf": LEGACY_RESOLVED_DROPIN}, NETWORK_BACKUPS)
    atomic_write(RESOLVED_DROPIN, RESOLVED_TEMPLATE.format(dns=dns))
    atomic_write(NM_DROPIN, NM_TEXT)
    atomic_write(SERVICE_DROPIN, SERVICE_TEXT)
    clear_parked()
    # The drop-in from the old setup guide disabled the stub listener
    if LEGACY_RESOLVED_DROPIN.exists():
        LEGACY_RESOLVED_DROPIN.unlink()

    changed_resolv = False
    if not (RESOLV_CONF.is_symlink() and os.readlink(RESOLV_CONF) in (STUB_RESOLV, "/run/systemd/resolve/stub-resolv.conf")):
        if RESOLV_CONF.exists() and not RESOLV_CONF.is_symlink():
            shutil.copy2(RESOLV_CONF, backup_dir / "resolv.conf")
        tmp = RESOLV_CONF.with_name(".resolv.conf.dnscrypt-ui")
        if tmp.is_symlink() or tmp.exists():
            tmp.unlink()
        os.symlink(STUB_RESOLV, tmp)
        os.replace(tmp, RESOLV_CONF)
        restorecon(RESOLV_CONF)
        changed_resolv = True

    run(["systemctl", "daemon-reload"], timeout=60)
    leftover = reload_network(clear_link_dns=True)
    if leftover:
        detail = "; ".join(f"{k}: {' '.join(v)}" for k, v in leftover.items())
        raise HelperError(f"Settings were written, but these networks still have their own DNS servers: {detail}")
    return {
        "ok": True,
        "message": "System DNS now goes through dnscrypt-proxy",
        "backup": str(backup_dir),
        "resolv_conf_replaced": changed_resolv,
    }


def cmd_undo_dns():
    backup(ROUTING_FILES, NETWORK_BACKUPS)
    removed = []
    for p in ROUTING_FILES.values():
        if p.exists():
            p.unlink()
            removed.append(str(p))
    clear_parked()
    run(["systemctl", "daemon-reload"], timeout=60)
    reload_network(clear_link_dns=False)
    return {"ok": True, "message": "Restored your network's DNS servers", "removed": removed}


def cmd_disable():
    parked = []
    active_files = {label: p for label, p in ROUTING_FILES.items() if p.exists()}
    if active_files:
        clear_parked()
        PARK_DIR.mkdir(parents=True, mode=0o755)
        for label, p in active_files.items():
            shutil.move(str(p), str(PARK_DIR / label))
            parked.append(label)
        run(["systemctl", "daemon-reload"], timeout=60)
        # Give DNS back to the network before the proxy goes away
        reload_network(clear_link_dns=False)
    run(["systemctl", "stop", SERVICE], timeout=60, check=True)
    return {
        "ok": True,
        "message": "Encrypted DNS is off" + (". Using your network's DNS servers" if parked else ""),
        "parked": parked,
    }


def cmd_enable():
    listen = current_listen()
    parked = {label: p for label, p in ROUTING_FILES.items() if (PARK_DIR / label).exists()}
    if not parked:
        run(["systemctl", "start", SERVICE], timeout=60)
        if not wait_stable():
            raise HelperError("dnscrypt-proxy did not start.", output=journal_tail())
        return {"ok": True, "message": "dnscrypt-proxy started", "routed": False}

    ensure_serving(listen[0])
    sync_resolved(listen[0])  # in case the listen address changed while parked
    for label, p in parked.items():
        p.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(PARK_DIR / label), str(p))
        restorecon(p)
    clear_parked()
    run(["systemctl", "daemon-reload"], timeout=60)
    leftover = reload_network(clear_link_dns=True)
    if leftover:
        detail = "; ".join(f"{k}: {' '.join(v)}" for k, v in leftover.items())
        raise HelperError(f"Encrypted DNS is on, but these networks still have their own DNS servers: {detail}")
    return {"ok": True, "message": "Encrypted DNS is on. System DNS goes through dnscrypt-proxy", "routed": True}


def link_dns():
    """{link name: [servers]} for non-loopback links, from resolvectl."""
    res = run(["resolvectl", "dns"], timeout=10)
    found = {}
    for line in res.stdout.splitlines():
        m = re.match(r"^Link \d+ \(([^)]+)\):\s*(.*)$", line.strip())
        if m and m.group(1) != "lo" and m.group(2).strip():
            found[m.group(1)] = m.group(2).split()
    return found


def revert_links():
    for _index, name in socket.if_nameindex():
        if name != "lo":
            run(["resolvectl", "revert", name], timeout=10)


def reload_network(clear_link_dns: bool):
    """
    Apply the NetworkManager and systemd-resolved drop-ins.

    systemd-resolved keeps per-link DNS servers across restarts, and
    NetworkManager may keep pushing them until its config is re-read, so when
    routing through dnscrypt-proxy clear them and verify, restarting
    NetworkManager if they come back. Returns links that still have DNS.
    """
    have_nm = bool(shutil.which("nmcli"))
    if have_nm:
        run(["nmcli", "general", "reload", "conf"], timeout=30)
    run(["systemctl", "restart", "systemd-resolved"], timeout=30, check=True)

    if not clear_link_dns:
        # Make NetworkManager push connection DNS again
        if have_nm:
            run(["systemctl", "restart", "NetworkManager"], timeout=60)
            time.sleep(3)
        run(["resolvectl", "flush-caches"], timeout=10)
        return {}

    if have_nm:
        run(["nmcli", "general", "reload", "dns-full"], timeout=30)
    revert_links()
    time.sleep(1)
    leftover = link_dns()
    if leftover and have_nm:
        run(["systemctl", "restart", "NetworkManager"], timeout=60)
        time.sleep(3)
        revert_links()
        time.sleep(1)
        leftover = link_dns()
    run(["resolvectl", "flush-caches"], timeout=10)
    return leftover


def main(argv):
    if os.geteuid() != 0:
        raise HelperError("The helper must run as root (through pkexec)")
    if len(argv) < 2:
        raise HelperError("Missing command")
    cmd = argv[1]
    if cmd == "apply" and len(argv) == 2:
        return cmd_apply()
    if cmd == "setup-dns" and len(argv) == 3:
        return cmd_setup_dns(argv[2])
    if cmd == "undo-dns" and len(argv) == 2:
        return cmd_undo_dns()
    if cmd == "enable" and len(argv) == 2:
        return cmd_enable()
    if cmd == "disable" and len(argv) == 2:
        return cmd_disable()
    raise HelperError(f"Unknown command: {' '.join(argv[1:])}")


if __name__ == "__main__":
    os.umask(0o022)
    try:
        result = main(sys.argv)
    except HelperError as e:
        result = {"ok": False, "message": str(e), **e.extra}
    except Exception as e:
        result = {"ok": False, "message": f"Unexpected error: {e}"}
    print(json.dumps(result))
    sys.exit(0 if result.get("ok") else 1)
